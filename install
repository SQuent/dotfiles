#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGFILE="${BASEDIR}/install.log"
START_TIME=$(date +%s)
NIX_EXPERIMENTAL_FLAGS=(--extra-experimental-features "nix-command flakes")

log() {
    echo "$1" | tee -a "$LOGFILE"
}

cd "${BASEDIR}"

OS="$(uname -s)"
ARCH="$(uname -m)"
log "Starting script at $(date)"
log "Detected OS: ${OS} (${ARCH})"

case "${OS}-${ARCH}" in
    Darwin-arm64)
        SYSTEM="aarch64-darwin"
        ;;
    Linux-x86_64)
        SYSTEM="x86_64-linux"
        ;;
    Linux-aarch64)
        SYSTEM="aarch64-linux"
        ;;
    *)
        log "Unsupported OS/architecture: ${OS} ${ARCH} (this flake only supports aarch64-darwin, x86_64-linux and aarch64-linux)"
        exit 1
        ;;
esac
log "Target home-manager configuration: .#${SYSTEM}"

if ! command -v nix &>/dev/null; then
    log "Nix not found. Installing via the Determinate Systems installer..."

    NIX_INSTALL_ARGS=(install --no-confirm)
    if [[ "${OS}" == "Linux" && ! -d /run/systemd/system ]]; then
        log "No running init system detected (e.g. building a container image). Installing with --init none."
        NIX_INSTALL_ARGS=(install linux --init none --no-confirm)
    fi

    curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix \
        | sh -s -- "${NIX_INSTALL_ARGS[@]}" 2>&1 | tee -a "$LOGFILE"

    for profile_script in \
        /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
        /etc/profile.d/nix-daemon.sh; do
        if [ -e "$profile_script" ]; then
            # shellcheck disable=SC1090
            source "$profile_script"
            break
        fi
    done
else
    log "Nix already installed ($(nix --version))."
fi

if ! command -v nix &>/dev/null; then
    log "Nix installation finished but 'nix' is still not on PATH. Open a new shell and re-run ./install."
    exit 1
fi


git config --global --add safe.directory "${BASEDIR}"

# Push over SSH rather than https, so a clone from the public URL still lets
# you commit back. Derived from the existing remote instead of hardcoding the
# repo, and a no-op if origin is already SSH (or absent, as in a container).
ORIGIN_URL="$(git -C "${BASEDIR}" remote get-url origin 2>/dev/null || true)"
if [[ "${ORIGIN_URL}" == https://github.com/* ]]; then
    SSH_URL="git@github.com:${ORIGIN_URL#https://github.com/}"
    [[ "${SSH_URL}" == *.git ]] || SSH_URL="${SSH_URL}.git"
    log "Switching origin to SSH: ${SSH_URL}"
    git -C "${BASEDIR}" remote set-url origin "${SSH_URL}"
fi

log "Running home-manager switch for .#${SYSTEM}..."
nix "${NIX_EXPERIMENTAL_FLAGS[@]}" run .#home-manager -- switch --flake ".#${SYSTEM}" --impure 2>&1 | tee -a "$LOGFILE"
log "home-manager switch done."


if [[ "${OS}" == "Linux" && "$(id -u)" -ne 0 && ! -f /.dockerenv ]]; then
    ZSH_BIN="$HOME/.nix-profile/bin/zsh"
    CURRENT_USER="$(whoami)"

    if [[ -x "$ZSH_BIN" && "$(getent passwd "$CURRENT_USER" | cut -d: -f7)" != "$ZSH_BIN" ]]; then
        log "Setting zsh as the default login shell..."
        sudo chsh -s "$ZSH_BIN" "$CURRENT_USER"
    fi

    SUDOERS_FILE="/etc/sudoers.d/$CURRENT_USER"
    if ! sudo grep -q "^$CURRENT_USER ALL=(ALL) NOPASSWD:ALL$" "$SUDOERS_FILE" 2>/dev/null; then
        log "Adding $CURRENT_USER to passwordless sudoers..."
        echo "$CURRENT_USER ALL=(ALL) NOPASSWD:ALL" | sudo tee "$SUDOERS_FILE" >/dev/null
        sudo chmod 440 "$SUDOERS_FILE"
    fi
fi

total_time=$(( $(date +%s) - START_TIME ))
if [[ $total_time -gt 60 ]]; then
    total_time="$(( total_time / 60 )) minutes"
else
    total_time="${total_time} seconds"
fi

log "Script completed in $total_time"
